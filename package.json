{
  "name": "stackbyalif-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@stackbyalif/web run dev",
    "dev:web": "npm --workspace=@stackbyalif/web run dev",
    "dev:admin": "npm --workspace=@stackbyalif/admin run dev",
    "dev:client": "npm --workspace=@stackbyalif/client run dev",
    "create-admin": "node scripts/create-admin.mjs",
    "build": "npm --workspace=@stackbyalif/web run build:next",
    "build:web": "npm --workspace=@stackbyalif/web run build:next",
    "build:admin": "npm --workspace=@stackbyalif/admin run build:next",
    "build:client": "npm --workspace=@stackbyalif/client run build:next",
    "backup": "node scripts/backup.mjs",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "dotenv": "^16.4.7"
  }
}
